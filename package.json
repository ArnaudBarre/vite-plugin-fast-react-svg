{
  "name": "vite-plugin-fast-react-svg",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "scripts/bundle.ts",
    "prettier": "bun prettier-ci --write",
    "prettier-ci": "prettier --ignore-path=.gitignore --check '**/*.{ts,json,md,yml}'",
    "check": "tsc && bun prettier-ci && bun run build && cd dist && publint"
  },
  "prettier": {
    "experimentalOperatorPosition": "start"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "vite": "^6.3 || ^7 || ^8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.14",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "typescript": "~6.0",
    "vite": "^8.0.5"
  }
}
